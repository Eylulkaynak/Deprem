    completionSubtitle: '{WARDROBE} {EXIT}'
    delayAfter: 3
  - interactable: {fileID: 1366993286}
    objectiveTitle: "A\u0130LE PLANINI HATIRLA"
    objectiveDetail: "\xC7izimdeki bulu\u015Fma noktas\u0131ndan kap\u0131 y\xF6n\xFCne
      do\u011Fru \xE7izgiyi takip et."
    completionSubtitle: "Anne (engelin arkas\u0131ndan): Biz buraday\u0131z. Siz
      koridora \xE7\u0131k\u0131n; toplanma alan\u0131nda bulu\u015Faca\u011F\u0131z."
