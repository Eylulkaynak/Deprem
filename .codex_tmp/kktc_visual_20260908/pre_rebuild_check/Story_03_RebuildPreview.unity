  - interactable: {fileID: 1366993286}
    objectiveTitle: "A\u0130LE PLANINI HATIRLA"
    objectiveDetail: "\xC7izimdeki bulu\u015Fma noktas\u0131ndan kap\u0131 y\xF6n\xFCne
